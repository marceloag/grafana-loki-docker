{
  "title": "Server & Security Overview",
  "uid": "server-security-overview",
  "tags": [
    "security",
    "fail2ban",
    "nginx-proxy-manager",
    "server",
    "vercel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Fail2ban",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Recent Ban / Unban Events",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"fail2ban\"} | regexp \"\\\\[(?P<jail>[\\\\w-]+)\\\\]\\\\s+(?P<action>Ban|Unban)\\\\s+(?P<ip>[0-9a-fA-F:.]+)\" | line_format \"{{.action}} {{.ip}} (jail={{.jail}})\""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bans netos (rango visible)",
      "description": "Aproximación: Ban - Unban en el rango visible. No es un gauge exacto del estado actual.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              },
              {
                "value": 10,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"fail2ban\", action=\"Ban\"}[$__range])) - sum(count_over_time({job=\"fail2ban\", action=\"Unban\"}[$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Ban Events Rate by Jail",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 16,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (jail) (count_over_time({job=\"fail2ban\", action=\"Ban\"}[$__interval]))",
          "legendFormat": "{{jail}}"
        }
      ]
    },
    {
